---
// Sets the stored theme (dark by default) before the page paints; the docs use the same key.
import GitHubLinks from './GitHubLinks.astro';
---
<GitHubLinks />
<script is:inline>
  document.documentElement.dataset.theme =
    (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme')) === 'light' ? 'light' : 'dark';
</script>
