const { size = 34, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false"><circle cx="32" cy="32" r="30" fill="#2f9a62"></circle><circle cx="22" cy="24" r="8" fill="#fff"></circle><circle cx="42" cy="24" r="8" fill="#fff"></circle><circle cx="23" cy="25" r="4" fill="#13201a"></circle><circle cx="43" cy="25" r="4" fill="#13201a"></circle><path d="M2 40 Q12 34 22 40 T42 40 T62 40 V62 H2Z" fill="#2b7fb8"></path></svg>
