---
// The footer of the home page, Get started, Where to use it, the rule pages and the blog.
// The release checklist edits the version in the last line ("No tracking, no cookies · v…").
import MoatMark from './MoatMark.astro';
---
  <footer class="site-footer">
    <div class="wrap top">
      <div class="about">
        <span class="name"><MoatMark size={32} />openmoat</span>
        <p>Checks what your AI coding agents do before it runs. Open source, runs on your machine.</p>
        <code><span class="p">$</span> brew install crocodile-labs/tap/openmoat</code>
      </div>
      <div class="cols">
        <div><span class="h">PRODUCT</span><a href="/get-started/">Get started</a><a href="/#see">See it work</a><a href="/where-to-use-it/">Where to use it</a><a href="/docs/supported-features/">Supported features</a><a href="/r/">Every rule</a></div>
        <div><span class="h">DOCS</span><a href="/docs/quickstart/">Quick start</a><a href="/docs/blocked/">Something was blocked</a><a href="/docs/work-across-repos/">Work across repos</a><a href="/docs/allow-reference/">Every allow and its impact</a><a href="/docs/limits/">Limits</a></div>
        <div><span class="h">PROJECT</span><a href="https://github.com/crocodile-labs/openmoat">GitHub</a><a href="https://github.com/crocodile-labs/openmoat/releases">Releases</a><a href="https://github.com/crocodile-labs/openmoat/blob/main/CHANGELOG.md">Changelog</a><a href="/blog/">Blog</a><a href="https://github.com/crocodile-labs/openmoat/blob/main/SECURITY.md">Report a bypass</a></div>
        <div><span class="h">COMMUNITY</span><a href="https://www.reddit.com/r/openmoat/">r/openmoat</a><a href="https://github.com/crocodile-labs/openmoat/issues">Issues</a><a href="https://github.com/crocodile-labs/openmoat/blob/main/CONTRIBUTING.md">Contributing</a></div>
      </div>
    </div>
    <div class="wrap bottom">
      <span>© 2026 Crocodile Labs · MIT or Apache-2.0</span>
      <span>No tracking, no cookies · v0.24.0</span>
    </div>
  </footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-footer); }
  .top { padding-top: 48px; padding-bottom: 28px; display: flex; flex-wrap: wrap; gap: 40px; }
  .about { flex: 1 1 280px; display: flex; flex-direction: column; gap: 14px; }
  .name { display: flex; gap: 10px; align-items: center; font-weight: 800; font-size: 20px; letter-spacing: -0.03em; }
  .about p { margin: 0; color: var(--muted); font-size: 14px; max-width: 300px; }
  .about code { align-self: flex-start; font-size: 13px; background: var(--term); color: var(--t-fg); border-radius: 10px; padding: 8px 12px; }
  .about .p { color: var(--t-allow); }
  .cols { flex: 3 1 560px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; font-size: 14px; }
  .cols div { display: flex; flex-direction: column; gap: 10px; }
  .h { font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--muted-2); }
  .cols a { color: var(--muted); text-decoration: none; }
  .cols a:hover { color: var(--fg); text-decoration: underline; }
  .bottom { padding-top: 18px; padding-bottom: 28px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; color: var(--muted-2); }
  @media (max-width: 760px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
