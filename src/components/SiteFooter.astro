---
// The footer of the home page and the blog.
---
  <footer style="border-top: 1px solid var(--line); background: var(--bg-footer)">
    <div style="max-width: 1240px; margin: 0 auto; padding: 56px 24px 32px; display: flex; flex-wrap: wrap; gap: 48px">
      <div style="flex: 1 1 300px; display: flex; flex-direction: column; gap: 14px">
        <span style="display: flex; gap: 10px; align-items: center; font-weight: 600; font-size: 18px"><img src="/assets/logo.svg" alt="" style="width: 32px; height: 32px">OpenMoat</span>
        <p style="margin: 0; color: var(--muted); font-size: 14px; max-width: 300px">Security for AI coding agents. Open source, runs on your machine.</p>
        <code style="align-self: flex-start; font-family: 'Geist Mono', monospace; font-size: 13px; background: var(--panel); border: 1px solid var(--line-2); border-radius: 6px; padding: 8px 12px"><span style="color: var(--accent)">$</span> brew install crocodile-labs/tap/moat</code>
      </div>
      <div style="flex: 3 1 600px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; font-size: 14px">
        <div style="display: flex; flex-direction: column; gap: 10px"><span style="font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--muted-2)">PRODUCT</span><a href="/#install" style="color: var(--muted); text-decoration: none">Install</a><a href="/#stops" style="color: var(--muted); text-decoration: none">What it stops</a><a href="/#architecture" style="color: var(--muted); text-decoration: none">Architecture</a><a href="/#sandbox" style="color: var(--muted); text-decoration: none">Sandbox</a><a href="/#supported" style="color: var(--muted); text-decoration: none">Supported agents</a></div>
        <div style="display: flex; flex-direction: column; gap: 10px"><span style="font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--muted-2)">DOCS</span><a href="/docs/quickstart/" style="color: var(--muted); text-decoration: none">Quick start</a><a href="/docs/blocked/" style="color: var(--muted); text-decoration: none">Something was blocked</a><a href="/docs/work-across-repos/" style="color: var(--muted); text-decoration: none">Work across repos</a><a href="/docs/allow-reference/" style="color: var(--muted); text-decoration: none">Every allow and its impact</a><a href="/docs/limits/" style="color: var(--muted); text-decoration: none">Limits</a></div>
        <div style="display: flex; flex-direction: column; gap: 10px"><span style="font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--muted-2)">PROJECT</span><a href="https://github.com/crocodile-labs/openmoat" style="color: var(--muted); text-decoration: none">GitHub</a><a href="https://github.com/crocodile-labs/openmoat/releases" style="color: var(--muted); text-decoration: none">Releases</a><a href="https://github.com/crocodile-labs/openmoat/blob/main/CHANGELOG.md" style="color: var(--muted); text-decoration: none">Changelog</a><a href="/blog/" style="color: var(--muted); text-decoration: none">Blog</a><a href="https://github.com/crocodile-labs/openmoat/blob/main/SECURITY.md" style="color: var(--muted); text-decoration: none">Report a bypass</a></div>
        <div style="display: flex; flex-direction: column; gap: 10px"><span style="font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.1em; color: var(--muted-2)">COMMUNITY</span><a href="https://www.reddit.com/r/openmoat/" style="color: var(--muted); text-decoration: none">r/openmoat</a><a href="https://github.com/crocodile-labs/openmoat/issues" style="color: var(--muted); text-decoration: none">Issues</a><a href="https://github.com/crocodile-labs/openmoat/blob/main/CONTRIBUTING.md" style="color: var(--muted); text-decoration: none">Contributing</a></div>
      </div>
    </div>
    <div style="max-width: 1240px; margin: 0 auto; padding: 20px 24px 32px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; color: var(--muted-2)">
      <span>© 2026 Crocodile Labs · MIT or Apache-2.0</span>
      <span>No tracking, no cookies · v0.5.7</span>
    </div>
  </footer>
