---
// The agents OpenMoat checks, as tiles: mark, name, protection level, link to its section.
// From data/agents.ts and data/logos.ts, like every other agent list on the site.
import { agents } from '../data/agents';
import { agents as logos } from '../data/logos';
const logo = (name: string) => logos.find((l) => l.name === name.replace(' (1 and 2)', ''));
---
<ul class="agents not-content">
  {agents.map((a) => {
    const l = logo(a.name);
    return (
      <li>
        <a href={a.docs} class:list={['agent', { sandbox: a.sandbox }]}>
          <span class="mark" aria-hidden="true">
            {l?.path ? <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d={l.path} /></svg> : l?.glyph ? <span>{l.glyph}</span> : <span>{a.name.charAt(0)}</span>}
          </span>
          <span class="text"><b>{a.name}</b><span class="level">{a.protectionShort}{a.protectionSub ? ` · ${a.protectionSub}` : ''}</span></span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .agents { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 0.6rem; }
  .agent { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 0.85rem; border: 1px solid var(--om-line); border-radius: 16px; background: var(--om-card); text-decoration: none; color: var(--sl-color-white); height: 100%; box-sizing: border-box; }
  .agent:hover { border-color: var(--sl-color-accent); }
  .mark { flex: none; width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--sl-color-gray-6); color: var(--sl-color-white); font-weight: 700; }
  .sandbox .mark { background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
  .text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; }
  .text b { font-size: 0.92rem; }
  .level { font-size: 0.76rem; color: var(--sl-color-gray-3); }
  .sandbox .level { color: var(--sl-color-accent); font-weight: 600; }
</style>
