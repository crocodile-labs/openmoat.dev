---
// The floating pill header of the home page, Get started, Where to use it, the rule pages
// and the blog. The page's own section is marked with aria-current.
import MoatMark from './MoatMark.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/#see', label: 'See it work', on: false },
  { href: '/where-to-use-it/', label: 'Where to use it', on: path.startsWith('/where-to-use-it') },
  { href: '/docs/', label: 'Docs', on: false },
  { href: '/blog/', label: 'Blog', on: path.startsWith('/blog') },
  { href: '/#break', label: 'Break it', on: false },
];
---
<header class="site-header">
  <nav aria-label="Main" class="pill">
    <a href="/" class="brand"><MoatMark size={34} /><span>openmoat</span></a>
    <div class="links">
      {links.map((l) => <a href={l.href} aria-current={l.on ? 'page' : undefined}>{l.label}</a>)}
    </div>
    <a class="gh" href="https://github.com/crocodile-labs/openmoat">GitHub</a>
    <a class="install" href="/get-started/" aria-current={path.startsWith('/get-started') ? 'page' : undefined}>Get started</a>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; padding: 14px 24px; }
  .pill { max-width: 1180px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 22px; background: rgba(255, 253, 248, 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--line); border-radius: 999px; padding: 8px 10px 8px 16px; box-shadow: 0 8px 30px rgba(60, 45, 20, 0.06); }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg); font-weight: 800; font-size: 22px; letter-spacing: -0.03em; }
  .brand:hover { color: var(--fg); }
  .links { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 15px; flex: 1 1 auto; }
  .links a { color: var(--muted); text-decoration: none; padding: 6px 0; }
  .links a:hover, .links a[aria-current='page'] { color: var(--fg); }
  .links a[aria-current='page'] { font-weight: 600; box-shadow: inset 0 -2px 0 var(--amber); }
  .gh { color: var(--fg); text-decoration: none; font-size: 14px; padding: 9px 10px; }
  .install { background: var(--fg); color: var(--bg); text-decoration: none; border-radius: 999px; padding: 11px 20px; font-size: 14px; font-weight: 600; }
  .install:hover { background: #000; color: #fff; }
  @media (max-width: 860px) {
    .site-header { position: static; padding: 10px 12px; }
    .pill { border-radius: 24px; padding: 10px 14px; }
    .links { order: 3; flex-basis: 100%; gap: 4px 16px; }
    .gh { margin-left: auto; }
  }
</style>
