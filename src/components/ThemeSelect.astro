---
// One button instead of Starlight's dropdown: sun in dark, moon in light. The choice
// is stored under the same key the home page reads, so both keep the same theme.
import { Icon } from '@astrojs/starlight/components';
---

<openmoat-theme-toggle>
  <button type="button" aria-label="Switch to light theme" title="Switch theme">
    <Icon name="sun" class="sun" />
    <Icon name="moon" class="moon" />
  </button>
</openmoat-theme-toggle>

<script>
  class ThemeToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('button');
      const label = () => {
        const light = document.documentElement.dataset.theme === 'light';
        button?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      };
      label();
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
        label();
      });
    }
  }
  customElements.define('openmoat-theme-toggle', ThemeToggle);
</script>

<style>
  button {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
    font-size: 1.1rem;
  }
  button:hover {
    border-color: var(--sl-color-gray-3);
  }
  :global([data-theme='light']) .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>
