---
// The supported agents at a glance, as agent tiles, from the one list in data/agents.ts.
// variant "glance": Supported agents' overview; "intro": protection and a link only.
import AgentFacts from './AgentFacts.astro';
import { agents } from '../data/agents';
interface Props { variant: 'glance' | 'intro' }
const { variant } = Astro.props;
const rows = agents.map((a) => ({
  name: a.name, href: a.docs,
  facts: (variant === 'glance'
    ? [
        ['Protection', a.protection],
        ['Hook run by the real agent', a.hookProven || 'preview on every OS'],
        ['Where you answer a review', a.answer],
        ['openmoat init --hosts', `<code>${a.host}</code>`],
      ]
    : [['Protection', a.protection]]) as [string, string][],
}));
if (variant === 'glance') {
  rows.push({
    name: 'Continue CLI', href: '/docs/agents/#continue-cli',
    facts: [
      ['Protection', 'not checked: it runs no hooks and is no longer maintained upstream'],
      ['Hook run by the real agent', 'none: it runs no hook'],
      ['Where you answer a review', 'none: use <code>openmoat run</code>'],
      ['openmoat init --hosts', 'none'],
    ],
  });
}
---
<AgentFacts rows={rows} label="Supported agents" />
