---
// Every rule id an OpenMoat block message can link to.
import Page from '../../layouts/Page.astro';
import { rules } from '../../data/rules';

const groups = [
  { id: 'denied', name: 'Denied', note: 'Never offered for approval.', verdict: 'deny', items: rules.filter((r) => r.source === 'policy' && r.verdict === 'deny') },
  { id: 'held', name: 'Held for review', note: 'You approve or refuse each call.', verdict: 'review', items: rules.filter((r) => r.source === 'policy' && r.verdict === 'review') },
  { id: 'built-in', name: 'OpenMoat’s own checks', note: 'Built in, not in the policy file.', verdict: '', items: rules.filter((r) => r.source === 'builtin') },
];
---
<Page title="Rules · OpenMoat" description="Every rule OpenMoat's block messages name: what it stops and why.">
  <main class="rules wrap">
    <p class="kicker">Rules</p>
    <h1 class="display">What each rule stops, and why</h1>
    <p class="lead">Every message OpenMoat sends when it blocks or holds a call ends with a link here. Rules from a policy pack or a repository’s own policy are in that policy file.</p>
    <nav class="jump" aria-label="Groups">{groups.map((g) => <a href={`#${g.id}`}>{g.name} <span>{g.items.length}</span></a>)}</nav>
    {groups.map((g) => (
      <section id={g.id}>
        <h2>{g.name}</h2>
        <p class="note">{g.note}</p>
        <ul class="grid">
          {g.items.map((r) => (
            <li>
              <a class="card rule" href={`/r/${r.id}/`}>
                <span class={`chip v-${r.verdict}`}>{r.verdict === 'deny' ? '✕ deny' : '? review'}</span>
                <code>{r.id}</code>
                <span class="t">{r.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Page>

<style>
  .rules { max-width: 1080px; padding-top: 40px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 14px; }
  h1 { font-size: clamp(36px, 6vw, 60px); }
  .lead { max-width: 720px; font-size: 18px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 4px; }
  .jump a { text-decoration: none; color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 600; }
  .jump a:hover { border-color: var(--line-2); }
  .jump span { color: var(--muted-2); font-weight: 500; margin-left: 4px; }
  section { margin-top: 18px; }
  h2 { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.03em; }
  .note { margin: 2px 0 12px; color: var(--muted); font-size: 15px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }
  .rule { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; height: 100%; box-sizing: border-box; text-decoration: none; color: var(--fg); border-radius: 18px; }
  .rule:hover { border-color: var(--line-2); color: var(--fg); }
  .rule code { font-size: 15px; font-weight: 600; }
  .t { color: var(--muted); font-size: 14px; line-height: 1.45; }
  .chip { align-self: flex-start; font-family: var(--mono); font-size: 11px; font-weight: 600; border-radius: 999px; padding: 2px 9px; }
  .v-deny { background: var(--deny-bg); color: var(--deny); }
  .v-review { background: var(--review-bg); color: var(--review); }
</style>
