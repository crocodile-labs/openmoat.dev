---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PostCover from '../../components/PostCover.astro';

// Newest first; the first post is the featured one, the rest follow in a list.
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [featured, ...rest] = posts;
const tagsOf = (post: (typeof posts)[number]) => (post.data.tags.length ? post.data.tags : [post.data.tag]);
const allTags = [...new Set(posts.flatMap(tagsOf))];
const day = (d: Date) => d.toISOString().slice(0, 10);
const long = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Page title="Blog · OpenMoat" description="How OpenMoat works, how to use it, and what we learn building it.">
  <main class="wrap">
    <section class="intro">
      <p class="label">OPENMOAT BLOG</p>
      <h1>How it works, how to use it, and what we learn building it.</h1>
      <p class="lead">Guides and explainers on keeping AI coding agents away from your secrets, your files and your network. <a href="/blog/rss.xml">RSS</a></p>
      <div class="filters" role="group" aria-label="Filter posts by tag">
        <button type="button" class="chip" data-tag="" aria-pressed="true">Latest</button>
        {allTags.map((t) => <button type="button" class="chip" data-tag={t} aria-pressed="false">{t}</button>)}
      </div>
    </section>

    {featured && (
      <a class="featured post-item" href={`/blog/${featured.id}/`} data-tags={tagsOf(featured).join('|')}>
        <PostCover cmd={featured.data.cover} result={featured.data.coverResult} tone={featured.data.coverTone} large />
        <div class="text">
          <p class="meta"><time datetime={day(featured.data.date)}>{long(featured.data.date)}</time> · {featured.data.author} · {featured.data.minutes} min read</p>
          <h2>{featured.data.title}</h2>
          <p class="summary">{featured.data.summary}</p>
          <p class="tags">{tagsOf(featured).map((t) => <span>{t}</span>)}</p>
        </div>
      </a>
    )}

    <ul class="posts">
      {rest.map((post) => (
        <li class="post-item" data-tags={tagsOf(post).join('|')}>
          <a class="row" href={`/blog/${post.id}/`}>
            <PostCover cmd={post.data.cover} result={post.data.coverResult} tone={post.data.coverTone} />
            <div class="text">
              <p class="meta"><time datetime={day(post.data.date)}>{long(post.data.date)}</time></p>
              <h3>{post.data.title}</h3>
              <p class="summary">{post.data.summary}</p>
              <p class="byline">{post.data.author} · {post.data.minutes} min read {tagsOf(post).map((t) => <span class="tag">{t}</span>)}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" hidden>No posts with this tag yet.</p>
  </main>
</Page>

<script>
  // Tag filter: show the posts that carry the chosen tag; "Latest" shows all.
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const empty = document.querySelector<HTMLElement>('.empty');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const tag = chip.dataset.tag ?? '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    let shown = 0;
    items.forEach((item) => {
      const show = !tag || (item.dataset.tags ?? '').split('|').includes(tag);
      item.hidden = !show;
      if (show) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  }));
</script>

<style>
  .wrap { max-width: 1240px; margin: 0 auto; border-left: 1px solid var(--line); border-right: 1px solid var(--line); min-height: 60vh; }
  .intro { padding: 72px 48px 40px; background-image: radial-gradient(var(--dots) 1px, transparent 1px); background-size: 14px 14px; border-bottom: 1px solid var(--line); }
  .label { margin: 0 0 12px; font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.14em; color: var(--accent); font-weight: 600; }
  h1 { margin: 0; font-size: 48px; line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; max-width: 760px; }
  .lead { margin: 16px 0 0; color: var(--muted); font-size: 18px; max-width: 680px; }
  .lead a { color: var(--accent); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .chip { font-family: 'Geist Mono', monospace; font-size: 12px; padding: 6px 10px; border: 1px solid var(--line-2); border-radius: 4px; background: var(--bg); color: var(--muted); cursor: pointer; }
  .chip:hover { color: var(--fg); }
  .chip[aria-pressed='true'] { color: var(--accent); border-color: var(--accent-line); background: var(--accent-panel); }
  .featured { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin: 40px 48px; border: 1px solid var(--line-2); border-radius: 10px; overflow: hidden; background: var(--panel); text-decoration: none; color: var(--fg); }
  .featured:hover { border-color: var(--accent-line); }
  .featured :global(.cover) { border: 0; border-radius: 0; border-right: 1px solid var(--line-2); }
  .featured .text { padding: 40px; display: flex; flex-direction: column; justify-content: center; }
  .featured h2 { margin: 10px 0 12px; font-size: 32px; line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; }
  .featured[hidden] { display: none; }
  .meta { margin: 0; font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--muted-2); letter-spacing: 0.04em; }
  .summary { margin: 0; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0 0; }
  .tags span, .tag { font-family: 'Geist Mono', monospace; font-size: 11px; padding: 3px 8px; border: 1px solid var(--line-2); border-radius: 4px; color: var(--muted); }
  .posts { list-style: none; margin: 0 48px 56px; padding: 0; }
  .posts li { border-top: 1px solid var(--line); }
  .posts li[hidden] { display: none; }
  .row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 28px; padding: 28px 0; text-decoration: none; color: var(--fg); }
  .row:hover h3 { color: var(--accent); }
  .row :global(.cover) { padding: 16px; }
  .row :global(.cover code) { font-size: 11px; }
  .row .text { display: flex; flex-direction: column; gap: 8px; }
  h3 { margin: 0; font-size: 21px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; }
  .byline { margin: 4px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--muted-2); }
  .byline .tag { margin-left: 4px; }
  .empty { margin: 0 48px 56px; color: var(--muted); }
  @media (max-width: 860px) {
    .intro { padding-left: 20px; padding-right: 20px; }
    h1 { font-size: 34px; }
    .featured { grid-template-columns: 1fr; margin: 24px 20px; }
    .featured :global(.cover) { border-right: 0; border-bottom: 1px solid var(--line-2); padding: 28px; }
    .featured .text { padding: 24px; }
    .featured h2 { font-size: 26px; }
    .posts, .empty { margin-left: 20px; margin-right: 20px; }
    .row { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
