---
// Where to use it: situation tabs, then every part against every situation (the approved
// UseCases design). The data, checked against the docs' situation pages, is
// src/data/situations.ts.
import Page from '../layouts/Page.astro';
import MoatMark from '../components/MoatMark.astro';
import { parts, situations } from '../data/situations';

const part = (id: string) => parts.find((p) => p.id === id)!;
const runs = [
  { name: 'macOS', text: 'Hooks, the agents’ own sandboxes, and openmoat run on macOS 13 or later.' },
  { name: 'Linux', text: 'Hooks, the agents’ own sandboxes, and openmoat run: Landlock and seccomp, the Isolated tier where bubblewrap works.' },
  { name: 'Windows', text: 'Hooks apply the policy, and Codex’s own sandbox is set up. WSL2 for the other sandboxes and openmoat run.' },
  { name: 'Editors', text: 'Claude Code in VS Code and JetBrains uses the same hook as the CLI; Cursor uses its own hooks.', href: '/docs/editors/' },
  { name: 'GitHub', text: 'The merge check, as a GitHub Action on pull requests.', href: '/docs/check-a-pull-request/' },];
---
<Page title="Where to use OpenMoat" description="Pick your situation, a laptop, unattended agents, MCP servers, a team, CI, audit evidence or your own agent product, and see which parts of OpenMoat protect you there, with the first command.">
<main class="uc wrap">
  <div class="head">
    <p class="kicker">Where to use it</p>
    <h1 class="display">Pick your situation. See which parts protect you.</h1>
  </div>

  <div role="tablist" aria-label="Situation" class="sit-tabs">
    {situations.map((s, i) => (
      <button type="button" role="tab" id={`sit-${s.id}`} aria-controls={`about-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="sit-tab tab-btn">{s.title}</button>
    ))}
  </div>

  {situations.map((s, i) => (
    <section role="tabpanel" id={`about-${s.id}`} aria-labelledby={`sit-${s.id}`} class="about card" hidden={i !== 0}>
      <div class="left">
        <h2>{s.title}</h2>
        <p class="risk">{s.risk}</p>
        <div class="first">
          <span class="label">First command</span>
          <code><span class="p">$ </span>{s.cmd}</code>
        </div>
        <a class="btn btn-ghost" href={s.href}>Read the full guide →</a>
      </div>
      <div class="right">
        <span class="label">What protects you here</span>
        {s.core.map((id) => (
          <a class="part core" href={part(id).href}><span class="mk" aria-hidden="true">●</span><span><b>{part(id).name}</b><span>{part(id).does}</span></span><span class="sr-only"> (core)</span></a>
        ))}
        {s.helps.map((id) => (
          <a class="part" href={part(id).href}><span class="mk" aria-hidden="true">○</span><span><b>{part(id).name}</b><span>{part(id).does}</span></span><span class="sr-only"> (helps)</span></a>
        ))}
      </div>
    </section>
  ))}

  <section class="matrix">
    <h2 class="display h2">Every part, every situation</h2>
    <div class="table-wrap card">
      <table>
        <caption class="sr-only">Which parts of OpenMoat each situation uses: core, helps, or not used</caption>
        <thead>
          <tr><th scope="col">Situation</th>{parts.map((p) => <th scope="col"><a href={p.href}>{p.col}</a></th>)}</tr>
        </thead>
        <tbody>
          {situations.map((s) => (
            <tr>
              <th scope="row"><a href={s.href}>{s.title}</a></th>
              {parts.map((p) => s.core.includes(p.id)
                ? <td class="c"><span aria-hidden="true">●</span><span class="sr-only">core</span></td>
                : s.helps.includes(p.id)
                  ? <td class="h"><span aria-hidden="true">○</span><span class="sr-only">helps</span></td>
                  : <td class="n"><span aria-hidden="true">·</span><span class="sr-only">not used</span></td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="legend"><span class="c">●</span> core for that situation · <span class="h">○</span> helps · <span class="n">·</span> not used there. Each row follows its guide in the docs. Not in the table: <a href="/docs/session-taint/">session taint</a> and <a href="/docs/injected-input/">injected input</a>, which make the hook stricter after a session read untrusted content.</p>
  </section>

  <section class="runs">
    <h2 class="display h2">Where it runs</h2>
    <div class="run-grid">
      {runs.map((r) => r.href
        ? <a class="run card" href={r.href}><b>{r.name}</b><span>{r.text}</span></a>
        : <div class="run card"><b>{r.name}</b><span>{r.text}</span></div>)}
    </div>
    <p class="foot"><MoatMark size={28} /><span>What each agent gets: <a href="/docs/supported-features/">Supported features</a>. Ready? <a href="/get-started/">Get started</a>.</span></p>
  </section>
</main>
</Page>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.sit-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.about'));
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
    panels.forEach((p, j) => { p.hidden = i !== j; });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select((keys[e.key] + tabs.length) % tabs.length, true);
    });
  });
  const start = tabs.findIndex((t) => t.id === `sit-${location.hash.slice(1)}`);
  if (start >= 0) select(start);
</script>
<noscript><style>.about[hidden] { display: flex !important; margin-bottom: 16px; } .sit-tabs { display: none; }</style></noscript>

<style>
  .uc { padding-top: 40px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 14px; max-width: 820px; }
  .head h1 { font-size: clamp(38px, 6vw, 64px); }
  .h2 { font-size: clamp(30px, 4vw, 42px); letter-spacing: -0.035em; margin-bottom: 16px; }
  .sit-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .sit-tab { min-height: 44px; padding: 10px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--panel); color: var(--fg); font-weight: 600; font-size: 14px; }
  .sit-tab:hover { border-color: var(--line-2); }
  .sit-tab[aria-selected='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .about { display: flex; flex-wrap: wrap; gap: 28px; padding: 28px; border-radius: 28px; }
  .about[hidden] { display: none; }
  .left { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .left h2 { margin: 0; font-size: 34px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .risk { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.55; }
  .first { display: flex; flex-direction: column; gap: 6px; align-self: stretch; }
  .label { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-2); }
  .first code { background: var(--term); color: var(--t-fg); border-radius: 12px; padding: 12px 14px; font-size: 14px; overflow-wrap: anywhere; }
  .p { color: #8fa69a; user-select: none; }
  .right { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .part { display: flex; gap: 12px; align-items: flex-start; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; background: var(--bg); text-decoration: none; color: var(--fg); }
  .part:hover { border-color: var(--line-2); color: var(--fg); }
  .part > span:nth-child(2) { display: flex; flex-direction: column; gap: 2px; }
  .part b { font-size: 15px; }
  .part span span { font-size: 14px; color: var(--muted); }
  .mk { color: var(--accent); font-size: 14px; line-height: 1.6; }
  .part:not(.core) .mk { color: var(--muted-2); }
  .table-wrap { overflow-x: auto; border-radius: 20px; }
  table { border-collapse: collapse; width: 100%; min-width: 860px; font-size: 14px; }
  thead th { background: var(--panel-2); font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--muted); padding: 14px 8px; border-bottom: 1px solid var(--line); }
  thead th:first-child { text-align: left; padding-left: 16px; }
  thead a { color: var(--muted); text-decoration: none; }
  thead a:hover { color: var(--fg); text-decoration: underline; }
  tbody th { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--line); font-weight: 600; }
  tbody th a { color: var(--fg); text-decoration: none; }
  tbody th a:hover { text-decoration: underline; }
  td { text-align: center; padding: 14px 8px; border-bottom: 1px solid var(--line); font-size: 16px; }
  tbody tr:last-child > * { border-bottom: 0; }
  .c { color: var(--accent); } .h { color: var(--muted-2); } .n { color: var(--faint); }
  .legend { margin: 12px 0 0; font-size: 14px; color: var(--muted); }
  .run-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .run { padding: 18px; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--fg); border-radius: 18px; }
  a.run:hover { border-color: var(--line-2); color: var(--fg); }
  .run span { font-size: 14px; color: var(--muted); line-height: 1.5; }
  .foot { margin: 18px 0 0; display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 15px; }
  .foot svg { flex: none; }
  @media (max-width: 760px) { .about { padding: 20px; } }
</style>
