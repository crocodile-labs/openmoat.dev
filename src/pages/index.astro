    <section id="evidence" style="border-top: 1px solid #1c1c1c; padding: 56px 48px">
      <p style="margin: 0 0 12px; font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: 0.14em; color: #7fd88f; font-weight: 600">TESTED IN THE OPEN</p>
      <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid #262626; border-left: 1px solid #262626">
