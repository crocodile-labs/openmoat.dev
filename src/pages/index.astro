---
// The home page: the approved "Home v3" design. Every OpenMoat line on it comes from
// the code, the docs or a real run (see src/data/scenes.ts); the agents' own replies are
// examples, and the page says so. No framework, no external fonts or scripts.
// Release checklist: the NEW line below (its link and text) and the footer's version.
import Page from '../layouts/Page.astro';
import MoatMark from '../components/MoatMark.astro';
import { agents as logos } from '../data/logos';
import { agents as supported, agentList } from '../data/agents';
import { scenes, checks } from '../data/scenes';

const title = 'OpenMoat: your AI agents, checked first';
const description = `OpenMoat checks each tool call your coding agent's hook reports before it runs: it denies reads of your secrets and sends to hosts your policy does not list, holds what outlives the session for your review, and records every decision. For ${agentList()}. Open source, runs on your machine.`;

// The agents row: the best-known first, then "+N more" (the full list is data/agents.ts).
const shown = ['Claude Code', 'Codex', 'Cursor', 'Gemini CLI', 'GitHub Copilot CLI', 'OpenCode', 'OpenClaw', 'goose', 'Cline CLI'];
const row = shown.map((n) => logos.find((l) => l.name === n) ?? { name: n, path: null, glyph: null });
const more = supported.length - row.length;

const mark = { allow: '✓', defer: '→', review: '?', deny: '✕' } as const;
const three = [
  { cls: 'deny', icon: '✕', title: 'Stops what must never happen', text: 'Reading your keys and .env files, piping a download into a shell, sending to hosts your policy does not list.', cmd: '✕ deny · secrets-paths · pipe-to-shell' },
  { cls: 'review', icon: '?', title: 'Asks you when it smells a trick', text: 'A host, path or command that came from a page or an issue waits for your answer. So does code that runs later, like a git hook or a CI workflow.', cmd: '? review · injected-input · runs-later' },
  { cls: 'allow', icon: '✓', title: 'Lets your work run', text: 'Project files and dev commands go straight through. What it has no rule for is your agent’s call, as before.', cmd: '✓ allow · project-fs · dev-shell' },
];
const os = [
  { name: 'macOS', href: '/get-started/#macos' },
  { name: 'Linux', href: '/get-started/#linux' },
  { name: 'Windows', href: '/get-started/#windows' },
  { name: 'cargo', href: '/get-started/#cargo' },
];
---
<Page title={title} description={description}>
<main class="home">

  <section class="hero wrap">
    <div class="hero-text">
      <a class="release" href="/docs/releases/v0-24-0/"><span class="new">NEW</span> 0.24.0: `openmoat policy migrate` and JSON Schemas so your editor checks a policy as you type →</a>
      <h1 class="display">Your AI agents,<br><span class="under">checked first.<svg viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true"><path d="M2 12 Q75 2 150 10 T298 8" stroke="#f0a93b" stroke-width="6" fill="none" stroke-linecap="round"></path></svg></span></h1>
      <p class="lead">OpenMoat sits between your coding agent and your machine. It checks each call before it runs: your work goes through, reading your keys does not.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/get-started/">Get started</a>
        <a class="btn btn-ghost" href="#see"><span aria-hidden="true">▶</span> See it in your tools</a>
      </div>
      <ul class="ticks"><li>✓ Open source</li><li>✓ Runs on your machine</li><li>✓ No account</li><li>✓ No AI decides</li></ul>
    </div>

    <div class="hero-art">
      <div class="blob" aria-hidden="true"></div>
      <svg id="moat" class="moat" viewBox="0 0 400 400" role="img" aria-label="Moat, OpenMoat's crocodile, watching from the water">
        <ellipse cx="200" cy="330" rx="170" ry="26" fill="#9fd0e6"></ellipse>
        <path d="M60 250 Q60 120 200 110 Q340 120 340 250 Z" fill="#2f9a62"></path>
        <path d="M90 250 Q95 170 200 165 Q305 170 310 250 Z" fill="#3fb177"></path>
        <circle cx="140" cy="125" r="46" fill="#2f9a62"></circle>
        <circle cx="260" cy="125" r="46" fill="#2f9a62"></circle>
        <circle cx="140" cy="125" r="32" fill="#fffdf8"></circle>
        <circle cx="260" cy="125" r="32" fill="#fffdf8"></circle>
        <g id="moat-pupils" class="pupils">
          <circle cx="140" cy="128" r="15" fill="#13201a"></circle>
          <circle cx="260" cy="128" r="15" fill="#13201a"></circle>
          <circle cx="140" cy="122" r="5" fill="#fff"></circle>
          <circle cx="260" cy="122" r="5" fill="#fff"></circle>
        </g>
        <rect class="lid" x="104" y="80" width="72" height="14" rx="6" fill="#2f9a62"></rect>
        <rect class="lid" x="224" y="80" width="72" height="14" rx="6" fill="#2f9a62"></rect>
        <circle cx="175" cy="205" r="5" fill="#1d6b45"></circle>
        <circle cx="225" cy="205" r="5" fill="#1d6b45"></circle>
        <path class="wave" d="M30 262 Q70 236 110 262 T190 262 T270 262 T350 262 T390 262 V340 H30 Z" fill="#2b7fb8"></path>
        <path class="wave2" d="M30 280 Q70 258 110 280 T190 280 T270 280 T350 280 T390 280" stroke="#7cc3e6" stroke-width="5" fill="none" stroke-linecap="round"></path>
      </svg>
      <div class="badge b1" aria-hidden="true"><b class="v-allow">✓ allow</b>npm test</div>
      <div class="badge b2" aria-hidden="true"><b class="v-deny">✕ Read .env</b><span>secrets-paths</span></div>
      <div class="badge b3" aria-hidden="true">Moat checks <b>{supported.length} agents</b></div>
      <div class="badge b4" aria-hidden="true">? review · injected-input</div>
    </div>
  </section>

  <section aria-label="Works with" class="agents wrap">
    <span class="small">One install covers the agents you already use</span>
    <ul class="agent-chips">
      {row.map((a) => (
        <li class="om-chip">
          {a.path ? <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d={a.path} /></svg>
            : a.glyph ? <span aria-hidden="true" class="glyph">{a.glyph}</span> : <span aria-hidden="true" class="dot"></span>}
          {a.name}
        </li>
      ))}
      <li><a class="om-chip more" href="/docs/agents/">+{more} more</a></li>
    </ul>
  </section>

  <section id="see" class="see wrap">
    <div class="center">
      <p class="kicker">See it where you work</p>
      <h2 class="display h2">You keep working. <span class="green">Moat keeps watch.</span></h2>
    </div>

    <div role="tablist" aria-label="Where OpenMoat works" class="scene-tabs">
      {scenes.map((s, i) => (
        <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="scene-tab tab-btn">
          <span class="where">{s.where}</span><span>{s.name}</span>
        </button>
      ))}
    </div>

    {scenes.map((s, i) => (
      <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} class="stage" hidden={i !== 0} data-scene={s.id}>
        <div class="story">
          <span class="kicker light">{s.where}</span>
          <h3>{s.title}</h3>
          <ol>
            {s.story.map((t, n) => <li><span class="n" aria-hidden="true">{n + 1}</span><span>{t}</span></li>)}
          </ol>
          <div class="says"><MoatMark size={40} /><span>{s.moat}</span></div>
        </div>
        <div class:list={['window', { light: s.light }]}>
          <div class="bar">
            <span class="wdot r" aria-hidden="true"></span><span class="wdot y" aria-hidden="true"></span><span class="wdot g" aria-hidden="true"></span>
            <span class="wtitle">{s.window}</span>
            <button type="button" class="replay" hidden>Play again</button>
          </div>
          <div class="lines">
            {s.lines.map((l) => <div class={`ln k-${l.k}`}>{l.t}</div>)}
          </div>
        </div>
      </div>
    ))}
    <p class="note">OpenMoat’s lines are its real messages: the block text, the review reason, the merge check, <code>openmoat why</code>. The agents’ own replies, prompts and window titles are examples. <a href="https://github.com/crocodile-labs/openmoat/blob/main/docs/USAGE.md">Where they come from</a></p>
  </section>

  <section id="how" class="three wrap">
    {three.map((c) => (
      <div class={`card3 ${c.cls}`}>
        <span class="icon" aria-hidden="true">{c.icon}</span>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
        <code>{c.cmd}</code>
      </div>
    ))}
  </section>

  <section id="break" class="wrap">
    <div class="break card">
      <div class="break-text">
        <h2 class="display h2b">Think you can<br>sneak past?</h2>
        <p>Pick a command. See what OpenMoat decided for it, with the default policy.</p>
        <p class="small">These are real <code>openmoat policy check</code> results. Try your own, without running anything: <code>openmoat policy check "…"</code>. Found a way past? <a href="/docs/break-openmoat/">Break OpenMoat</a>.</p>
      </div>
      <div class="break-try">
        <div class="picker" role="radiogroup" aria-label="A command to check">
          {checks.map((c, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="pick tab-btn"><code>{c.cmd}</code></button>
          ))}
        </div>
        <div class="result" aria-live="polite">
          {checks.map((c, i) => (
            <div class="res" hidden={i !== 0}>
              <div class="cmdline"><span class="p">$</span> openmoat policy check '{c.cmd}'</div>
              <div class={`verdict v-${c.verdict}`}>{mark[c.verdict]} {c.verdict}</div>
              <div class="out">   rules : {c.rules}</div>
              <div class="out">   reason: {c.reason}</div>
              {c.verdict === 'defer' && <div class="hint">No rule for it: your agent’s own prompt decides, as before.</div>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="install" class="install wrap">
    <MoatMark size={96} />
    <h2 class="display h2c">Two commands. Done.</h2>
    <div class="shell">
      <div><span class="p">$</span> brew install crocodile-labs/tap/openmoat</div>
      <div><span class="p">$</span> openmoat init</div>
    </div>
    <p class="small"><code>openmoat init</code> asks before it changes each agent and backs up every file; <code>openmoat uninstall</code> puts it all back.</p>
    <div class="os">{os.map((o) => <a class="om-chip" href={o.href}>{o.name}</a>)}</div>
    <p class="small"><a href="/openmoat-bar/">Also: OpenMoat Bar, for your menu bar →</a></p>
  </section>
</main>
</Page>

<script>
  // Old links to sections the previous home page had: send them on.
  const moved: Record<string, string> = {
    stops: '#how', what: '#how', why: '#how', demo: '#see', architecture: '/docs/how-it-decides/',
    sandbox: '/docs/sandboxes/', features: '/docs/supported-features/', supported: '/docs/supported-features/',
    'where-it-fits': '/where-to-use-it/', 'openmoat-bar': '/openmoat-bar/', 'your-way': '/where-to-use-it/', evidence: '/docs/limits/',
  };
  const hash = location.hash.slice(1);
  if (hash && moved[hash] && !document.getElementById(hash)) location.replace(moved[hash]);

  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Moat's eyes: they look from side to side while lines come in, and narrow on a block.
  const pupils = document.getElementById('moat-pupils');
  const lids = Array.from(document.querySelectorAll<SVGRectElement>('#moat .lid'));
  const look = (n: number) => { if (!still) pupils?.setAttribute('transform', `translate(${n % 2 ? 6 : 0} 0)`); };
  const tense = (on: boolean) => {
    if (still) return;
    for (const lid of lids) { lid.setAttribute('y', on ? '92' : '80'); lid.setAttribute('height', on ? '34' : '14'); }
  };
  const tenseKinds = ['k-block', 'k-hold', 'k-gherr', 'k-termred'];

  // The scenes: a tab shows its window, which brings its lines in one by one.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.scene-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.stage'));
  let timer = 0;
  const play = (panel: HTMLElement) => {
    window.clearTimeout(timer);
    const lines = Array.from(panel.querySelectorAll<HTMLElement>('.ln'));
    const replay = panel.querySelector<HTMLButtonElement>('.replay');
    if (still) { lines.forEach((l) => l.classList.remove('pending')); return; }
    lines.forEach((l) => { l.classList.add('pending'); l.classList.remove('in'); });
    if (replay) replay.hidden = true;
    tense(false);
    let n = 0;
    const step = () => {
      const line = lines[n];
      if (!line) { if (replay) replay.hidden = false; timer = window.setTimeout(() => tense(false), 2600); return; }
      line.classList.remove('pending');
      line.classList.add('in');
      look(n);
      tense(tenseKinds.some((k) => line.classList.contains(k)));
      n += 1;
      timer = window.setTimeout(step, line.classList.contains('k-you') ? 900 : 620);
    };
    step();
  };
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
    panels.forEach((p, j) => { p.hidden = i !== j; });
    if (focus) tabs[i].focus();
    play(panels[i]);
  };
  // Arrow keys, Home and End move between the buttons of a group (tabs, radios).
  const arrows = (list: HTMLElement[], i: number, e: KeyboardEvent, go: (j: number) => void) => {
    const keys: Record<string, number> = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: list.length - 1 };
    if (!(e.key in keys)) return;
    e.preventDefault();
    go((keys[e.key] + list.length) % list.length);
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => arrows(tabs, i, e, (j) => select(j, true)));
  });
  panels.forEach((p) => p.querySelector('.replay')?.addEventListener('click', () => play(p)));
  // The first scene starts when it comes into view; until then its lines wait.
  if (!still && panels[0]) {
    panels[0].querySelectorAll('.ln').forEach((l) => l.classList.add('pending'));
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { seen.disconnect(); play(panels.find((p) => !p.hidden) ?? panels[0]); }
    }, { threshold: 0.25 });
    seen.observe(panels[0]);
  }

  // "Think you can sneak past?": example commands as a radio group, each with its result.
  const picks = Array.from(document.querySelectorAll<HTMLButtonElement>('.pick'));
  const results = Array.from(document.querySelectorAll<HTMLElement>('.res'));
  const choose = (i: number, focus = false) => {
    picks.forEach((p, j) => { p.setAttribute('aria-checked', String(i === j)); p.tabIndex = i === j ? 0 : -1; });
    results.forEach((r, j) => { r.hidden = i !== j; });
    if (focus) picks[i].focus();
    tense(!!results[i]?.querySelector('.v-deny'));
  };
  picks.forEach((p, i) => {
    p.addEventListener('click', () => choose(i));
    p.addEventListener('keydown', (e) => arrows(picks, i, e, (j) => choose(j, true)));
  });
</script>

<noscript><style>.stage[hidden] { display: flex !important; margin-top: 20px; } .scene-tabs { display: none; } .res[hidden] { display: flex !important; margin-bottom: 12px; } .picker { display: none; }</style></noscript>

<style>
  .home { padding-bottom: 24px; }
  .small { font-size: 14px; color: var(--muted-2); margin: 0; }
  .green { color: var(--accent); }
  .center { text-align: center; display: flex; flex-direction: column; gap: 12px; align-items: center; }

  /* hero */
  .hero { padding-top: 40px; padding-bottom: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 40px; }
  .hero-text { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .release { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px 6px 6px; font-size: 13px; line-height: 1.4; }
  .release:hover { color: var(--fg); border-color: var(--line-2); }
  .new { background: var(--button); color: #fff; border-radius: 999px; padding: 3px 10px; font-weight: 600; font-size: 12px; letter-spacing: 0.04em; flex: none; }
  h1.display { font-size: clamp(48px, 8vw, 84px); line-height: 0.95; letter-spacing: -0.045em; }
  .under { position: relative; display: inline-block; color: var(--accent); }
  .under svg { position: absolute; left: 0; bottom: -10px; width: 100%; height: 18px; }
  .hero .lead { max-width: 540px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .ctas .btn { font-size: 17px; padding: 14px 24px; }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 14px; color: var(--muted-2); }
  .hero-art { flex: 1 1 440px; min-width: 0; position: relative; height: 520px; }
  .blob { position: absolute; inset: 30px 10px 0 10px; border-radius: 48% 52% 46% 54%; background: radial-gradient(circle at 40% 35%, #d9f2e4, #bfe3f0 70%); }
  .moat { position: absolute; left: 50%; top: 52%; width: min(380px, 90%); height: auto; transform: translate(-50%, -50%); }
  .pupils { transition: transform 0.35s ease; }
  .lid { transition: y 0.25s ease, height 0.25s ease; }
  .wave { animation: bob 5s ease-in-out infinite; }
  .wave2 { animation: bob 5s ease-in-out infinite reverse; }
  @keyframes bob { 50% { transform: translateY(4px); } }
  .badge { position: absolute; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 10px 14px; box-shadow: 0 12px 30px rgba(60, 45, 20, 0.12); font-family: var(--mono); font-size: 12px; display: flex; gap: 8px; align-items: center; animation: float 6s ease-in-out infinite; }
  .b1 { left: 0; top: 70px; }
  .b2 { right: 0; top: 150px; flex-direction: column; align-items: flex-start; gap: 2px; border-color: var(--deny-line); animation-delay: -2s; }
  .b2 span { color: var(--muted-2); }
  .b3 { left: 20px; bottom: 60px; background: var(--term); color: var(--bg); border-color: var(--term); font-family: var(--font); font-size: 13px; animation-delay: -4s; }
  .b3 b { color: var(--t-allow); }
  .b4 { right: 30px; bottom: 30px; background: var(--review-bg); border-color: var(--review-line); color: var(--review); animation-delay: -1s; }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .v-allow { color: var(--allow); } .v-deny { color: var(--deny); } .v-review { color: var(--review); } .v-defer { color: var(--defer); }

  /* agents */
  .agents { padding-top: 24px; padding-bottom: 56px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .agent-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .agent-chips svg { flex: none; }
  .glyph { width: 16px; text-align: center; line-height: 1; }
  .dot { width: 16px; height: 16px; border-radius: 5px; background: #e9e3d6; display: inline-block; }
  .more { text-decoration: none; color: var(--accent); font-weight: 600; }
  .more:hover { border-color: var(--accent-line); }

  /* scenes */
  .see { padding-top: 24px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 28px; }
  .h2 { font-size: clamp(36px, 5.5vw, 56px); line-height: 1; letter-spacing: -0.035em; }
  .scene-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .scene-tab { min-height: 56px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 10px 18px; border-radius: 16px; font-weight: 600; font-size: 15px; border: 1px solid var(--line); background: var(--panel); color: var(--fg); text-align: left; }
  .scene-tab .where { font-size: 12px; font-weight: 500; color: var(--muted-2); }
  .scene-tab:hover { border-color: var(--line-2); }
  .scene-tab[aria-selected='true'] { background: var(--term); border-color: var(--term); color: var(--bg); }
  .scene-tab[aria-selected='true'] .where { color: #b9c9c0; }
  .stage { background: var(--term); border-radius: 28px; padding: 28px; box-shadow: 0 50px 100px rgba(19, 32, 26, 0.28); display: flex; flex-wrap: wrap; gap: 28px; }
  .stage[hidden] { display: none; }
  .story { flex: 1 1 280px; min-width: 0; color: var(--bg); display: flex; flex-direction: column; gap: 18px; padding: 8px; }
  .kicker.light { color: var(--t-allow); }
  .story h3 { margin: 0; font-weight: 800; font-size: clamp(26px, 3vw, 34px); line-height: 1.06; letter-spacing: -0.03em; }
  .story ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .story li { display: flex; gap: 12px; font-size: 15px; line-height: 1.5; color: #c8d6ce; }
  .story .n { flex: none; width: 24px; height: 24px; border-radius: 50%; background: #1f3329; color: var(--t-allow); display: flex; align-items: center; justify-content: center; font-size: 12px; font-family: var(--mono); }
  .says { margin-top: auto; display: flex; align-items: center; gap: 12px; background: #1a2b22; border-radius: 16px; padding: 12px 14px; font-size: 14px; color: #e6f2ea; }
  .says svg { flex: none; }
  .window { flex: 3 1 600px; min-width: 0; background: var(--term-2); border: 1px solid #22332a; border-radius: 18px; overflow: hidden; }
  .window .bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid #1c2a23; }
  .wdot { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .r { background: #ff5f57; } .y { background: #febc2e; } .g { background: #28c840; }
  .wtitle { margin-left: 10px; font-family: var(--mono); font-size: 12px; color: var(--t-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .replay { margin-left: auto; font: 600 12px var(--font); color: var(--t-fg); background: transparent; border: 1px solid #3a5045; border-radius: 999px; padding: 5px 12px; cursor: pointer; min-height: 30px; }
  .replay:hover { border-color: var(--t-allow); }
  .window.light { background: #ffffff; border-color: #d1d9e0; }
  .window.light .bar { border-bottom-color: #d1d9e0; }
  .window.light .wtitle { color: #59636e; }
  .window.light .replay { color: #1f2328; border-color: #d1d9e0; }
  .lines { padding: 18px 20px; font-family: var(--mono); font-size: 13px; line-height: 1.7; min-height: 470px; display: flex; flex-direction: column; gap: 3px; }
