---
// A page with the site's header, footer and warm light look: the home page, Get started,
// Where to use it, the rule pages, the 404 page and the blog use it. Fonts are bundled (no requests to
// anyone else), and nothing on these pages tracks a visitor.
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/800.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/600.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeInit from '../components/ThemeInit.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  published?: Date;
}
const { title, description, type = 'website', published } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content="https://openmoat.dev/assets/logo.png">
{published && <meta property="article:published_time" content={published.toISOString().slice(0, 10)}>}
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#f5f1e8">
<ThemeInit />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="OpenMoat blog" href="/blog/rss.xml">
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div style="min-height: 100vh">
  <SiteHeader />
  <div id="main"><slot /></div>
  <SiteFooter />
</div>
<style is:global>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 50; background: var(--fg); color: var(--bg); padding: 10px 16px; border-radius: 10px; }
  .skip:focus { left: 12px; }
</style>
</body>
</html>
